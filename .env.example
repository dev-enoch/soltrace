# ==============================================================================
# Soltrace Environment Configuration
# ==============================================================================
# SECURITY RULE:
# All credentials are strictly server-side. Never add NEXT_PUBLIC_ prefixes.
# Automated CI bundle guards will fail the build if any client leaks are found.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Stabilisation
# ------------------------------------------------------------------------------

# Google Gemini API Key (Server-only)
# Generate from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Solana JSON-RPC URL (Server-only, optional: defaults to public mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------------------------
# Stage 2: Own the Data
# ------------------------------------------------------------------------------

# PostgreSQL connection strings (Neon serverless Postgres)
# DATABASE_URL: pooled connection for application queries (via PgBouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/soltrace?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL: direct connection for Prisma migrations (bypassing PgBouncer)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/soltrace?sslmode=require"

# Redis connection string for hot caching & rate limits (Upstash Redis)
REDIS_URL="rediss://default:password@sample.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://sample.upstash.io"
UPSTASH_REDIS_REST_TOKEN="sample_token"

# Helius DAS & RPC API key (https://helius.dev)
HELIUS_API_KEY=

# ------------------------------------------------------------------------------
# Stage 4: Alerts & Digest Delivery (Upcoming)
# ------------------------------------------------------------------------------

# Resend API key for email digests (https://resend.com)
RESEND_API_KEY=

# Telegram Bot Token for real-time wallet alerts (via @BotFather)
TELEGRAM_BOT_TOKEN=
