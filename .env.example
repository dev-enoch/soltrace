# ==============================================================================
# Soltrace Environment Configuration
# ==============================================================================
# SECURITY RULE:
# All credentials are strictly server-side. Never add NEXT_PUBLIC_ prefixes.
# Automated CI bundle guards will fail the build if any client leaks are found.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Stabilisation (Current)
# ------------------------------------------------------------------------------

# Google Gemini API Key (Server-only)
# Generate from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Solana JSON-RPC URL (Server-only, optional: defaults to public mainnet)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ------------------------------------------------------------------------------
# Stage 2: Own the Data (Upcoming)
# ------------------------------------------------------------------------------

# PostgreSQL connection string (Neon serverless Postgres)
# DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/soltrace?sslmode=require"

# Redis connection string for hot caching & rate limits (Upstash Redis)
# REDIS_URL="rediss://default:password@sample.upstash.io:6379"

# Helius DAS & RPC API key (https://helius.dev)
# HELIUS_API_KEY=

# ------------------------------------------------------------------------------
# Stage 4: Alerts & Digest Delivery (Upcoming)
# ------------------------------------------------------------------------------

# Resend API key for email digests (https://resend.com)
# RESEND_API_KEY=

# Telegram Bot Token for real-time wallet alerts (via @BotFather)
# TELEGRAM_BOT_TOKEN=
